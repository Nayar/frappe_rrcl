 "query": "SELECT\n    ecf.date as date,\n    SUM(credit) AS inflows,\n    SUM(debit) AS outflows,\n    credit - debit AS netflow,\n    count(*) as transactions\nFROM `tabRRCL Cashflow` AS ecf\nWHERE ecf.date BETWEEN %(date_from)s AND %(date_to)s\nGROUP BY ecf.date\nORDER BY date;\n",
